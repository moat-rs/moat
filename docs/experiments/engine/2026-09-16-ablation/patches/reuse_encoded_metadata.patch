+#[test]
+fn writes_enforce_pipeline_limits_with_a_more_permissive_builder() {
+    let file = file();
+    let strict = FrameLimits::new(PAGE as u32, 16).unwrap();
+    let queue = FileQueue::new(file, 2).unwrap();
+    let mut pipeline = Pipeline::new(queue, header(), strict, 0).unwrap();
+    for len in [17, PAGE] {
+        let value = vec![0x37; len];
+        let input = frame(1, 1, &value);
+        let mut buffer = AlignedBuf::zeroed(input.encoded_len());
+        buffer.fill(0xa5);
+        let address = buffer.as_ptr();
+        let rejected = pipeline.write(&input, buffer).unwrap_err();
+        if len == 17 {
+            assert!(matches!(
+                rejected.error,
+                Error::Frame(moat_engine_v2::frame::Error::ValueTooLarge { len: 17, max: 16 })
+            ));
+        } else {
+            assert!(matches!(
+                rejected.error,
+                Error::Frame(moat_engine_v2::frame::Error::FrameFull { .. })
+            ));
+        }
+        assert_eq!(rejected.input.as_ptr(), address);
+        assert!(rejected.input.iter().all(|&byte| byte == 0xa5));
+        assert!(drain(&mut pipeline).is_empty());
+    }
+
+    // The builder's configured limit can be larger when its actual data fits.
+    write(&mut pipeline, 1, 2, b"accepted");
+    assert!(matches!(
+        drain(&mut pipeline).pop(),
+        Some(Completion::Write { result: Ok(()), .. })
+    ));
+    pipeline.read(key(1), 0..8, true, buffers()).unwrap();
+    match drain(&mut pipeline).pop().unwrap() {
+        Completion::Read { result, buffers, .. } => assert_eq!(buffers.view(result.unwrap()), b"accepted"),
+        _ => panic!("read"),
+    }
+}
