+fn diag_usage() -> libc::rusage {
+    let mut value = std::mem::MaybeUninit::<libc::rusage>::uninit();
+    assert_eq!(unsafe { libc::getrusage(libc::RUSAGE_THREAD, value.as_mut_ptr()) }, 0);
+    unsafe { value.assume_init() }
+}
+fn diag_cpu(t: libc::timeval) -> i64 { t.tv_sec * 1_000_000 + t.tv_usec }
+fn diag_wall() -> u128 {
+    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+}
